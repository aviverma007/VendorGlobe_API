# PDRN live load (app/pdrn_sync.py): SAP Production ZSD_PDRN -> SQL PDRN.dbo.SAP_PDRN
# Copy to  pdrn.env  in this folder (C:\VendorGlobe_API\pdrn.env) and fill in the SAP login.
# pdrn.env is git-ignored: never pushed, never changed by git pull. Changes are picked up at the
# next load (no restart needed), except VG_PDRN_TIMES which needs a service restart.

VG_PDRN_USER=
VG_PDRN_PASSWORD=

# ----- optional (leave as is) -----
# VG_PDRN_TIMES=13:00,17:00
# VG_PDRN_URL=https://vhsmwps4ci.sap.smartworlddevelopers.com:20400/sap/zpdrn
# VG_PDRN_CLIENT=
# VG_PDRN_BUKRS=1010,1070,2010,2070,3070
# VG_PDRN_WERKS=1011,1013,1070,1072,2010,2071,3072,3073
# VG_PDRN_STATUS=all
# VG_PDRN_DB_NAME=PDRN
# VG_PDRN_MIN_RATIO=0.9

# ----- INVR (ZSD_INVR / ZSDR_UNIT -> SQL PDRN.dbo.SAP_INVR), same login, loaded before PDRN -----
# Turn on once /sap/zinvr is transported to Production and activated in SICF:
# VG_INVR_ENABLED=1
# VG_INVR_URL=https://vhsmwps4ci.sap.smartworlddevelopers.com:20400/sap/zinvr
# VG_INVR_WERKS=1011,1013,1070,1072,2010,2071,3072,3073
# VG_INVR_TYPE=units
